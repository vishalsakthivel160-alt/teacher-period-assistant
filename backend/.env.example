# Copy this file to .env and fill in your values

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=teacher_period_assistant

# Secret used to sign login tokens (use a long random string in production)
JWT_SECRET=please_change_this_to_a_long_random_secret

# Port the server listens on
PORT=3000

# Public base URL (used only for building recovery/registration links)
BASE_URL=http://localhost:3000
